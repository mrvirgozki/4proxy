# ✅ GAMITIN ANG PORT 8080 PARA TUGMA SA CLOUD RUN
:8080 {
    # ✅ Lahat ng gRPC services — h2c mode
    handle_path /vless-grpc-virgozki {
        reverse_proxy h2c://127.0.0.1:10012 {
            transport http {
                versions h2c
                flush_interval -1
                read_timeout 3600s
                write_timeout 3600s
            }
        }
    }

    handle_path /vmess-grpc-virgozki {
        reverse_proxy h2c://127.0.0.1:10013 {
            transport http { versions h2c }
        }
    }

    handle_path /trojan-grpc-virgozki {
        reverse_proxy h2c://127.0.0.1:10014 {
            transport http { versions h2c }
        }
    }

    handle_path /ss-grpc-virgozki {
        reverse_proxy h2c://127.0.0.1:10015 {
            transport http { versions h2c }
        }
    }

    # ✅ Main UI at iba pang paths
    handle /* {
        file_server /usr/local/openresty/nginx/html/
    }

    # ✅ Optimization
    encode gzip zstd
    header X-Content-Type-Options nosniff
    header X-Frame-Options DENY
}

